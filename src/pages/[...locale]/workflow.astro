---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import Figure from '@/components/Figure.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import CodeBlock from '@/components/CodeBlock.astro';
import Stats from '@/components/Stats.astro';
import Callout from '@/components/Callout.astro';
import PullQuote from '@/components/PullQuote.astro';
import NextPages from '@/components/NextPages.astro';
import CtaBand from '@/components/CtaBand.astro';
import Related from '@/components/Related.astro';
import { related } from '@/data/articles';
import { repoUrl } from '@/data/site';
import { articles, articleUrl } from '@/data/articles';
import { skillIds } from '@/data/workflow';
import tally from '@/data/tally.json';
import { localePaths, useI18n, withText } from '@/i18n';
export const getStaticPaths = localePaths;

const { t, raw, href, date, number, locale } = useI18n(Astro, 'workflow');
type Text = { title: string; text: string };
const prompts = raw<{ code: string; text: string }[]>('start.items');
const skills = withText(skillIds.map((id) => ({ hue: id === 'release' ? 'rose' : id === 'pr-bump' ? 'amber' : 'violet', href: `${repoUrl('skills')}/tree/master/${id}` })) as { hue: 'violet' | 'rose' | 'amber'; href: string }[], raw<Text[]>('skills.items'))
  .map((s) => ({ ...s, title: `<code>${s.title}</code>` }));
const kaizen = withText([{ hue: 'violet' }, { hue: 'teal' }, { hue: 'blue' }, { hue: 'orange' }] as const, raw<Text[]>('kaizen.items'));
const knowledge = withText([{ hue: 'teal' }, { hue: 'violet' }, { hue: 'amber' }, { hue: 'rose' }] as const, raw<Text[]>('knowledge.items'));
const next = withText([{ hue: 'blue', href: '/ai-usagebar/' }, { hue: 'amber', href: '/ghpending/' }, { hue: 'rose', href: '/writing/' }] as const, raw<Text[]>('next'));
const skillsPost = articleUrl({ id: 'skills', ...articles.skills }, locale);
---
<Base title={t('meta.title')} description={t('meta.description')}>
  <PageHero hue="violet" kicker={t('kicker.workflow')} title={t('hero.title')} lede={t('hero.lede')}>
    <a href={repoUrl('skills')} class="btn btn-primary">{t('hero.primary')}</a>
    <a href="#copy" class="btn btn-ghost">{t('hero.secondary')}</a>
  </PageHero>

  <Section title={t('start.title')} lede={t('start.lede')} hue="violet" fill>
    <div class="grid gap-10 lg:grid-cols-2 items-start">
      <CodeBlock title={t('start.codeTitle')} code={'cd ~/Projects/ai-usagebar\nai-memory run claude\n# quota gone? same workstream, another agent\nai-memory run codex --yolo'} />
      <div>
        <p class="text-muted">{t('start.prompts')}</p>
        <ul class="grid gap-5 mt-5">
          {prompts.map((p) => (
            <li class="prompt">
              <code class="block">{p.code}</code>
              <p class="mt-2 text-muted text-[0.97rem]">{p.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <Section title={t('pipeline.title')} lede={t('pipeline.lede')} hue="violet" tint>
    <Figure name="workflow-pipeline" alt={t('pipeline.alt')} caption={t('pipeline.caption')} />
  </Section>

  <Section title={t('skills.title')} lede={t('skills.lede')} hue="violet" id="skills">
    <FeatureGrid items={skills} />
    <a href={repoUrl('skills')} class="btn btn-ghost mt-10">{t('skills.link')}</a>
  </Section>

  <Section title={t('kaizen.title')} lede={t('kaizen.lede')} hue="teal" id="kaizen">
    <FeatureGrid items={kaizen} cols={2} />
    <div class="mt-14"><PullQuote {...raw<{ text: string; cite: string }>('kaizen.quote')} /></div>
  </Section>

  <Section title={t('numbers.title')} lede={t('numbers.lede', { year: tally.year, date: date(tally.countedOn) })} hue="violet" tint>
    <Stats cols={3} items={[
      { n: tally.totals.projects, label: t('numbers.projects') },
      { n: tally.totals.commits, label: t('numbers.commits') },
      { n: tally.totals.prs, label: t('numbers.prs') },
      { n: tally.totals.issues, label: t('numbers.issues') },
      { n: tally.totals.code_added, label: t('numbers.code'), display: number(tally.totals.code_added, { notation: 'compact', maximumFractionDigits: 2 }) },
      { n: tally.totals.posts, label: t('numbers.posts') },
    ]} />
    <p class="mt-10 text-sm text-muted max-w-[52em]">{t('numbers.method')}</p>
    <details class="tally mt-8">
      <summary class="btn btn-ghost">{t('numbers.table.toggle')}</summary>
      <div class="table-wrap mt-6">
        <table class="table-site tally-table">
          <thead><tr><th>{t('numbers.table.project')}</th><th>{t('numbers.table.commits')}</th><th>{t('numbers.table.prs')}</th><th>{t('numbers.table.issues')}</th><th>{t('numbers.table.code')}</th></tr></thead>
          <tbody>
            {tally.projects.map((p) => {
              const label = p.repo ? p.repo.split('/')[1] : p.name;
              return (
                <tr>
                  <td>{p.repo && !p.private ? <a class="link" href={`https://github.com/${p.repo}`}>{label}</a> : <span>{label}</span>}{p.private && <span class="text-muted font-normal"> ({t('numbers.table.private')})</span>}</td>
                  <td>{number(p.commits ?? 0)}</td>
                  <td>{p.prs == null ? '·' : number(p.prs)}</td>
                  <td>{p.issues == null ? '·' : number(p.issues)}</td>
                  <td>{'posts' in p && p.posts != null ? t('numbers.table.posts', { n: p.posts }) : number(p.code_added ?? 0)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </details>
    <div class="mt-16"><PullQuote {...raw<{ text: string }>('numbers.quote')} /></div>
  </Section>

  <Section title={t('links.title')} lede={t('links.lede')} hue="violet">
    <Figure name="workflow-symlinks" alt={t('links.alt')} />
    <div class="max-w-2xl"><CodeBlock title={t('links.codeTitle')} code={'mkdir ~/Projects/my-skills/<name>   # add a SKILL.md\nfor h in ~/.claude/skills ~/.agents/skills ~/.codex/skills; do\n  ln -s ~/Projects/my-skills/<name> "$h/<name>"\ndone'} /></div>
  </Section>

  <section class="wrap" id="copy">
    <Callout title={t('copy.title')} hue="red">
      <p>{t('copy.text')}</p>
      <p><a class="link" href={skillsPost}>{t('copy.link')}</a></p>
    </Callout>
  </section>

  <Section title={t('knowledge.title')} lede={t('knowledge.lede')} hue="teal">
    <FeatureGrid items={knowledge} cols={2} />
  </Section>

  <Related ids={related.workflow} hue="violet" />

  <NextPages title={t('next.title')} items={next} />
  <CtaBand />
</Base>

<style>
  .tally summary { list-style: none; cursor: pointer; }
  .tally summary::-webkit-details-marker { display: none; }
  .tally-table td:not(:first-child), .tally-table th:not(:first-child) { text-align: end; font-variant-numeric: tabular-nums; font-family: var(--font-mono); font-size: 0.92rem; }
  .tally-table td { min-width: 0; }
  .prompt code { font-size: 0.95rem; color: var(--violet); background: var(--violet-soft); border: 0; padding: 0.55rem 0.8rem; border-radius: 0.6rem; overflow-wrap: anywhere; }
</style>
