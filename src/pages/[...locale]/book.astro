---
// The book: "Competent Enough" / "Competente o Suficiente". Downloads of the current preview in both languages, the
// 3D cover (rendered by scripts/render-book.py from the official cover), what is inside and how it is made.
// Structure and links in src/data/book.ts, words in the `book` catalog.
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import Stats from '@/components/Stats.astro';
import Callout from '@/components/Callout.astro';
import NextPages from '@/components/NextPages.astro';
import CtaBand from '@/components/CtaBand.astro';
import BookReader from '@/components/BookReader.astro';
import PullQuote from '@/components/PullQuote.astro';
import AmazonIcon from '@/components/AmazonIcon.astro';
import { articles, articleUrl } from '@/data/articles';
import bookEn from '@/assets/img/book/book-en.png';
import bookPt from '@/assets/img/book/book-pt.png';
import { book, bookFile, bookEdition, bookVersion, type BookFormat } from '@/data/book';
import { localePaths, useI18n, withText } from '@/i18n';
export const getStaticPaths = localePaths;

const { t, raw, locale, date } = useI18n(Astro, 'book');
type Text = { title: string; text: string };
const mine = book.editions.find((e) => e.id === bookEdition(locale))!;
const covers = { en: bookEn, pt: bookPt };
const formats: BookFormat[] = ['epub', 'ebook', 'print'];
const parts = raw<{ title: string; question: string }[]>('inside.parts');
const stats = [
  { n: mine.pages, label: t('inside.stats.pages') },
  { n: book.numbers.chapters, label: t('inside.stats.chapters') },
  { n: book.numbers.glossary, label: t('inside.stats.glossary') },
  { n: book.numbers.references, label: t('inside.stats.references') },
];
const version = t('downloads.version', { version: bookVersion, date: date(book.released) });
const next = withText([{ hue: 'cerulean', href: '/limits/' }, { hue: 'pennant', href: '/agi/' }] as const, raw<Text[]>('next'));
---
<Base title={t('meta.title')} description={t('meta.description')}>
  <PageHero
    pavilion="book"
    hue="jade"
    kicker={t('hero.kicker')}
    title={t(`editions.${mine.id}.title`)}
    lede={t(`editions.${mine.id}.subtitle`)}
    art={covers[mine.id]}
    artAlt={t(`editions.${mine.id}.alt`)}
    artFit="contain"
  >
    <a href={bookFile(mine.file, 'epub')} class="btn btn-primary">{t('hero.epub')}</a>
    <a href={book.amazon[mine.id]} class="btn btn-ghost amazon-button"><AmazonIcon />{t('hero.amazon')}</a>
    <a href={bookFile(mine.file, 'ebook')} class="btn btn-ghost">{t('hero.pdf')}</a>
    <a href="#downloads" class="btn btn-ghost">{t('hero.all')}</a>
    <p class="version basis-full">{version}</p>
  </PageHero>

  <section class="wrap pt-8 lg:pt-12" data-hue="mauve">
    <div class="free-card">
      <Callout title={t('free.title')} hue="mauve" level={2}>
        <p>{t('free.text')}</p>
        <p class="mt-3">{t('free.cost')}</p>
      </Callout>
    </div>
    <div class="intro-cards grid gap-6 md:grid-cols-2 items-stretch">
      <Callout title={t('audience')} hue="mauve" level={2}>
        <p>{t('intro')}</p>
      </Callout>
      <Callout title={t('preview.title', { version: book.label })} hue="mauve" level={2}>
        <p>{t('preview.text', { date: date(book.released) })}</p>
        <p class="mt-3"><a class="link" href={book.issues}>{t('preview.issues')}</a> · <a class="link" href={`${book.repo}/releases/tag/${book.tag}`}>{t('preview.notes')}</a></p>
      </Callout>
    </div>
  </section>

  <Section id="read" title={t('reader.title')} lede={t('reader.lede')} hue="mauve">
    <BookReader />
  </Section>

  <Section id="downloads" title={t('downloads.title')} lede={t('downloads.lede')} hue="mauve" tint>
    <div class="grid gap-6 md:grid-cols-2">
      {book.editions.map((e) => (
        <div class="cell">
          <div class="kicker"><span class="dot" aria-hidden="true"></span>{t(`editions.${e.id}.language`)}</div>
          <h3 class="text-2xl mt-3">{t(`editions.${e.id}.title`)}</h3>
          <p class="version mt-1">{version}</p>
          <a class="amazon-listing" href={book.amazon[e.id]}>
            <AmazonIcon size={22} />
            <span><span class="font-semibold">{t('amazon.buy')}</span><span class="text-muted text-sm">{t(`amazon.formats.${e.id}`)}</span></span>
          </a>
          <ul class="mt-5 grid gap-2">
            {formats.map((f) => (
              <li><a class="dl" href={bookFile(e.file, f)}><span class="font-semibold">{t(`downloads.formats.${f}.name`)}</span><span class="text-muted text-sm">{t(`downloads.formats.${f}.for`)}</span></a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Section>

  <Section title={t('inside.title')} lede={t('inside.lede')} hue="mauve">
    <Stats items={stats} />
    <ol class="parts mt-14">
      {parts.map((p) => <li><h3 class="text-xl">{p.title}</h3><p class="mt-1 text-muted">{p.question}</p></li>)}
    </ol>
    <p class="mt-10 text-muted max-w-[46em]">{t('inside.extras')}</p>
  </Section>

  <Section id="making-of" title={t('made.title')} lede={t('made.lede')} hue="mauve" tint>
    <ul class="ticks text-lg max-w-[46em]">{raw<string[]>('made.points').map((p) => <li>{p}</li>)}</ul>
    <div class="mt-10 max-w-[46em]"><PullQuote text={t('made.quote')} original={t('made.quoteOriginal')} /></div>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={articleUrl({ id: 'bookMakingOf', ...articles.bookMakingOf }, locale)} class="btn btn-primary">{t('made.post')}</a>
      <a href={book.repo} class="btn btn-ghost">{t('made.repo')}</a>
    </div>
  </Section>

  <NextPages title={t('next.title')} items={next} />
  <CtaBand kind="learn" />
</Base>
<style>
  :global(#read) { padding-block-start: 3rem; }
  .version { font-family: var(--font-sign); font-size: var(--text-sm); color: var(--muted); }
  .free-card :global(.callout) { margin-block: 0 1.5rem; }
  .intro-cards :global(.callout) { block-size: 100%; margin-block: 0; }
  .amazon-button { gap: 0.55rem; }
  .amazon-listing { display: flex; align-items: center; gap: 0.9rem; margin-block-start: 1.25rem; padding: 0.9rem 1rem; min-block-size: 3.5rem; border: 1px solid var(--action); background: var(--action); color: var(--on-action); border-radius: 0.2rem; }
  .amazon-listing > span { display: grid; gap: 0.1rem; }
  .amazon-listing .text-muted { color: inherit; opacity: 0.78; }
  .amazon-listing:hover { background: var(--action-hi); }
  .dl { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.25rem 1rem; padding: 0.75rem 1rem; border-radius: 0.75rem; border: 1px solid var(--line); min-block-size: 2.75rem; align-items: center; }
  .dl:hover { border-color: var(--hue-vivid); }
  .parts { display: grid; gap: 1.75rem 3rem; counter-reset: part; }
  @media (min-width: 48rem) { .parts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { :global(#read) { padding-block-start: 6.25rem; } }
  .parts li { counter-increment: part; padding-inline-start: 3rem; position: relative; }
  .parts li::before { content: counter(part, upper-roman); position: absolute; inset-inline-start: 0; font-family: var(--font-display); font-weight: 800; color: var(--hue); font-size: 1.4rem; }
</style>
