---
// Print source for the /limits/ PDF deck (noindex, not in the sitemap). scripts/build-decks.mjs prints it.
import DeckLayout from '@/layouts/Deck.astro';
import Deck from '@/components/deck/Deck.astro';
import { limits } from '@/data/limits';
import { localePaths, useI18n } from '@/i18n';
export const getStaticPaths = localePaths;
const { t, raw } = useI18n(Astro, 'limits');
const motto = raw<{ text: string; original: string }>('motto');
---
<DeckLayout title={t('meta.title')}>
  <Deck ns="limits" hue="blue" path="/limits/" sections={limits.sections} opening={{ text: motto.text, original: motto.original }} closing={{ text: t('sections.job.quote'), original: t('sections.job.quoteOriginal') }} />
</DeckLayout>
