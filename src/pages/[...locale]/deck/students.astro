---
// Print source for the /students/ PDF deck (noindex, not in the sitemap). scripts/build-decks.mjs prints it.
import DeckLayout from '@/layouts/Deck.astro';
import Deck from '@/components/deck/Deck.astro';
import { students } from '@/data/students';
import videos from '@/data/videos.json';
import { localePaths, useI18n } from '@/i18n';
export const getStaticPaths = localePaths;
const { t } = useI18n(Astro, 'students');
---
<DeckLayout title={t('meta.title')}>
  <Deck ns="students" hue="amber" path="/students/" sections={students.sections}
    opening={{ text: t('quote.text'), original: t('quote.original'), cite: t('quote.cite') }}
    closing={{ text: t('takeaways.quote'), original: t('takeaways.quoteOriginal') }}
    videos={videos.akitando} />
</DeckLayout>
