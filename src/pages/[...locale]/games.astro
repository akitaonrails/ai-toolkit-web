---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import Figure from '@/components/Figure.astro';
import Shot from '@/components/Shot.astro';
import FeatureGrid from '@/components/FeatureGrid.astro';
import CodeBlock from '@/components/CodeBlock.astro';
import Stats from '@/components/Stats.astro';
import Callout from '@/components/Callout.astro';
import RepoMeta from '@/components/RepoMeta.astro';
import NextPages from '@/components/NextPages.astro';
import CtaBand from '@/components/CtaBand.astro';
import Related from '@/components/Related.astro';
import { related } from '@/data/articles';
import menuShot from '@/assets/img/shots/games-menu.jpg';
import { repoUrl } from '@/data/site';
import { games, funToDrive, launchers, launcherSdk } from '@/data/games';
import { articles, articleUrl } from '@/data/articles';
import { repo } from '@/data/github';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { localePaths, useI18n, withText } from '@/i18n';
export const getStaticPaths = localePaths;

const { t, raw, date, number, locale } = useI18n(Astro, 'games');
// One gameplay frame per launcher, from the videos in the owner's posts (docs/sources.md).
const shots = import.meta.glob<{ default: ImageMetadata }>('/src/assets/img/shots/launchers/*.jpg', { eager: true });
const shot = (id: string) => shots[`/src/assets/img/shots/launchers/${id}.jpg`].default;
const releases = Object.fromEntries(await Promise.all(launchers.map(async (l) => [l.id, (await repo(l.repo)).release?.tag])));
const post = (id: keyof typeof articles) => articleUrl(articles[id], locale);
// The SDK's setup, from the "How to make a launcher" steps in the SDK post.
const sdkSetup = 'cd ~/Projects\ngit clone https://github.com/akitaonrails/rea-launcher-sdk\n# REA, the reverse engineering MCP\nnpx rea-agents setup\n# Claude Code only\nrea-launcher-sdk/scripts/install-skills';
type Text = { title: string; text: string };
const box = raw<Text[]>('box.items').map((b) => ({ ...b, hue: 'copper' as const }));
const next = withText([{ hue: 'patina', href: '/setup/' }, { hue: 'amethyst', href: '/workflow/' }] as const, raw<Text[]>('next'));
// From the distrobox-gaming README's Quick Start and Commands sections.
const playbooks = 'ansible-playbook site.yml                 # the whole box, from scratch\nansible-playbook site.yml                 # again: nothing changes\nansible-playbook reset-configs.yml --tags esde   # reset one frontend\nansible-playbook backup.yml && ansible-playbook restore.yml\nansible-playbook site.yml --tags verify   # post-setup checks';
const ogm = 'yay -S omarchy-games-menu-bin\nogm scan && ogm refresh\ngames-menu   # or bind it: bind = SUPER, G, exec, games-menu';
---
<Base title={t('meta.title')} description={t('meta.description')}>
  <PageHero pavilion="games" hue="copper" kicker={t('kicker.games')} title={t('hero.title')} lede={t('hero.lede')}>
    <a href={repoUrl('distrobox')} class="btn btn-primary">{t('hero.primary')}</a>
    <a href={repoUrl('gamesMenu')} class="btn btn-ghost">{t('hero.secondary')}</a>
  </PageHero>
  <Section title={t('drive.title')} lede={t('drive.lede')} hue="copper" id="fun-to-drive">
    <div class="grid gap-10 lg:grid-cols-[1.35fr_1fr] items-start">
      <figure>
        <video class="drive-video" src={funToDrive.video} poster={funToDrive.poster} width={funToDrive.width} height={funToDrive.height} controls preload="none" playsinline aria-label={t('drive.videoLabel')}></video>
        <figcaption class="mt-3 text-muted text-[0.95rem] italic">{t('drive.caption')}</figcaption>
      </figure>
      <div>
        <ul class="ticks">{raw<string[]>('drive.points').map((p) => <li>{p}</li>)}</ul>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={funToDrive.play} class="btn btn-primary">{t('drive.play')}</a>
          <a href={repoUrl('funToDrive')} class="btn btn-ghost">{t('drive.source')}</a>
        </div>
      </div>
    </div>
  </Section>

  <Section title={t('launchers.title')} lede={t('launchers.lede')} hue="copper" tint id="launchers">
    <p class="font-sign text-sm text-muted -mt-4">{t('launchers.own')}</p>
    <ol class="lx-grid mt-10">
      {launchers.map((l) => (
        <li class="lx">
          <figure class="lx-shot">
            <Image src={shot(l.id)} alt={t(`launchers.items.${l.id}.alt`)} widths={[400, 640, 960]} sizes="(min-width: 1024px) 24rem, (min-width: 640px) 45vw, 92vw" />
            <span class="lx-year">{number(l.year, { useGrouping: false })}</span>
          </figure>
          <h3 class="font-card font-semibold text-xl !leading-tight mt-6">{t(`launchers.items.${l.id}.name`)}</h3>
          {(l.sdk || l.linuxOnly) && (
            <p class="lx-tags">
              {l.sdk && <span>{t('launchers.sdkMade')}</span>}
              {l.linuxOnly && <span>{t('launchers.linuxOnly')}</span>}
            </p>
          )}
          <p class="lx-was"><strong>{t('launchers.was')}</strong> {t(`launchers.items.${l.id}.was`)}</p>
          <ul class="ticks lx-adds">{raw<string[]>(`launchers.items.${l.id}.adds`).map((a) => <li>{a}</li>)}</ul>
          <p class="lx-links">
            {releases[l.id] && <a class="link" href={`${repoUrl(l.repo)}/releases/latest`}>{t('launchers.release', { tag: releases[l.id] })}</a>}
            <a class="link" href={repoUrl(l.repo)}>{t('launchers.source')}</a>
            {l.id === 'cmr1' && <a class="link" href={repoUrl('cmr1Recomp')}>{t('launchers.items.cmr1.recomp')}</a>}
            {l.id === 'cmr1' && <a class="link" href={post('cmr1Launcher')}>{t('launchers.items.cmr1.story')}</a>}
          </p>
        </li>
      ))}
    </ol>
    <div class="mt-14 grid gap-6 lg:grid-cols-[auto_1fr] items-start">
      <a href={post('racingLaunchers')} class="btn btn-ghost">{t('launchers.post')}</a>
      <p class="text-muted max-w-[40em]">{t('launchers.note')}</p>
    </div>
  </Section>

  <Section title={t('sdk.title')} lede={t('sdk.lede')} hue="copper" ink id="launcher-sdk">
    <div class="grid gap-14 lg:grid-cols-[1fr_1.15fr] items-start">
      <div>
        <h3 class="font-card font-semibold text-xl">{t('sdk.stepsTitle')}</h3>
        <ol class="sdk-steps mt-6">{raw<string[]>('sdk.steps').map((s) => <li>{s}</li>)}</ol>
        <div class="mt-12">
          <Stats cols={2} items={[
            { n: launcherSdk.launchers, label: t('sdk.stats.launchers', { games: number(launcherSdk.games) }) },
            { n: launcherSdk.tests, label: t('sdk.stats.tests') },
            { n: launcherSdk.sdkCoverage, format: { style: 'percent', minimumFractionDigits: 0, maximumFractionDigits: 0 }, label: t('sdk.stats.coverage', { tests: number(launcherSdk.sdkTests) }) },
            { n: launcherSdk.hours, prefix: '~', label: t('sdk.stats.hours') },
          ]} />
          <p class="mt-4 font-sign text-sm text-muted">{t('sdk.statsNote', { date: date(launcherSdk.readOn) })}</p>
        </div>
      </div>
      <div>
        <h3 class="font-card font-semibold text-xl">{t('sdk.howTitle')}</h3>
        <p class="mt-4">{t('sdk.how')}</p>
        <div class="mt-6"><CodeBlock title={t('sdk.codeTitle')} code={sdkSetup} /></div>
        <p class="prompt-line mt-6" dir="auto">{t('sdk.prompt')}</p>
        <p class="mt-3 font-sign text-sm text-muted">{t('sdk.promptNote')}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={repoUrl('launcherSdk')} class="btn btn-primary">{t('sdk.primary')}</a>
          <a href={post('launcherSdk')} class="btn btn-ghost">{t('sdk.post')}</a>
        </div>
        <div class="mt-6"><RepoMeta id="launcherSdk" /></div>
      </div>
    </div>
  </Section>

  <Section title={t('retro.title')} hue="copper" id="retro-gaming">
    <Shot src={menuShot} alt={t('hero.shotAlt')} caption={t('hero.caption')} zoom={false} />
  </Section>

  <Section title={t('clean.title')} lede={t('clean.lede')} hue="copper" fill>
    <Figure name="games-clean-host" alt={t('clean.alt')} />
    <ul class="ticks grid gap-4 md:grid-cols-2 !gap-x-12">{raw<string[]>('clean.points').map((p) => <li>{p}</li>)}</ul>
  </Section>

  <Section title={t('idempotent.title')} lede={t('idempotent.lede')} hue="copper" tint>
    <div class="grid gap-10 lg:grid-cols-[1.3fr_1fr] items-start">
      <CodeBlock title={t('idempotent.codeTitle')} code={playbooks} />
      <Stats cols={1} items={[
        { n: games.docs, label: t('idempotent.docs') },
        { n: games.commits, label: t('idempotent.commits', { date: date(games.since) }) },
      ]} />
    </div>
  </Section>

  <Section title={t('research.title')} lede={t('research.lede')} hue="copper">
    <a href={`${repoUrl('distrobox')}/tree/master/docs`} class="btn btn-ghost">{t('research.link')}</a>
  </Section>

  <Section title={t('use.title')} lede={t('use.lede')} hue="copper" tint id="use">
    <div class="grid gap-8 lg:grid-cols-2 items-start">
      <CodeBlock title={t('use.codeTitle')} code={'git clone https://github.com/akitaonrails/distrobox-gaming\ncd distrobox-gaming\nclaude'} />
      <div>
        <p class="prompt-line" dir="auto">{t("use.prompt")}</p>
        <p class="mt-5 text-muted">{t('use.note')}</p>
      </div>
    </div>
  </Section>

  <Section title={t('box.title')} hue="copper">
    <FeatureGrid items={box} cols={2} />
    <div class="mt-10"><RepoMeta id="distrobox" /></div>
  </Section>

  <Section title={t('menu.title')} lede={t('menu.lede')} hue="copper" id="launcher">
    <Figure name="games-stack" alt={t('menu.alt')} />
    <div class="grid gap-10 lg:grid-cols-2 items-start">
      <ul class="ticks">{raw<string[]>('menu.points').map((p) => <li>{p}</li>)}</ul>
      <div><CodeBlock code={ogm} /><div class="mt-6"><RepoMeta id="gamesMenu" /></div></div>
    </div>
  </Section>

  <section class="wrap">
    <Callout title={t('note.title')} hue="copper"><p>{t('note.text')}</p></Callout>
  </section>

  <Related ids={related.games} hue="copper" />

  <NextPages title={t('next.title')} items={next} />
  <CtaBand />
</Base>

<style>
  .drive-video { display: block; inline-size: 100%; block-size: auto; border-radius: var(--radius); border: 2px solid var(--v-brass); background: var(--ink); box-shadow: 0 0 0 4px var(--bg), 0 0 0 5px color-mix(in oklab, var(--v-brass) 55%, transparent), var(--shadow); }
  :global(.on-ink) .prompt-line { color: var(--hue); background: var(--hue-soft); }
  .prompt-line { font-family: var(--font-mono); font-size: 0.95rem; color: var(--copper); background: var(--copper-soft); padding: 0.8rem 1rem; border-radius: 0.6rem; }
  /* The launchers: one exhibit per game, in release order. The year sits on the frame like a rally door plate. */
  .lx-grid { display: grid; gap: 4rem 2.5rem; }
  @media (min-width: 40rem) { .lx-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .lx-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .lx { display: flex; flex-direction: column; }
  .lx-shot { position: relative; margin: 0; }
  .lx-shot :global(img) { display: block; inline-size: 100%; block-size: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius); border: 2px solid var(--v-brass); box-shadow: 0 0 0 3px var(--bg), 0 0 0 4px color-mix(in oklab, var(--v-brass) 50%, transparent); }
  .lx-year { position: absolute; inset-inline-start: 0.9rem; inset-block-end: -1.15rem; font-family: var(--font-display); font-size: 1.55rem; line-height: 1; padding: 0.35rem 0.7rem 0.3rem; color: var(--text); background: var(--bg); border: 2px solid var(--hue-vivid); border-radius: var(--radius); }
  .lx-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-block-start: 0.6rem; }
  .lx-tags span { font-family: var(--font-sign); font-size: var(--text-sm); padding: 0.15rem 0.55rem; border: 1px solid var(--hue-vivid); color: var(--hue); border-radius: 0.15rem; }
  .lx-was { margin-block-start: 0.9rem; color: var(--muted); }
  .lx-was strong { font-family: var(--font-sign); font-weight: 700; color: var(--text); }
  .lx-adds { margin-block-start: 1rem; gap: 0.45rem; font-size: 0.98rem; }
  .lx-links { margin-block-start: auto; padding-block-start: 1.1rem; display: flex; flex-wrap: wrap; gap: 0 1.3rem; font-family: var(--font-sign); font-size: var(--text-sm); }
  .lx-links a { padding-block: 0.6rem; }
  /* The SDK recipe really is a sequence, so its steps carry numbers. */
  .sdk-steps { counter-reset: step; display: grid; gap: 1.1rem; }
  .sdk-steps > li { counter-increment: step; display: grid; grid-template-columns: 2.6rem 1fr; gap: 0.8rem; align-items: baseline; }
  .sdk-steps > li::before { content: counter(step); font-family: var(--font-display); font-size: 1.7rem; line-height: 1; color: var(--hue-vivid); }
</style>
