---
// Lost and found: an empty lagoon after closing time, a blank signpost and a shrugging robot (poster-404).
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { localePaths, useI18n } from '@/i18n';
export const getStaticPaths = localePaths;
const { t, href } = useI18n(Astro);
---
<Base title={t('notfound.title')} noindex>
  <PageHero pavilion="notfound" hue="patina" kicker="404" title={t('notfound.title')} lede={t('notfound.text')}>
    <a href={href('/')} class="btn btn-primary">{t('notfound.home')}</a>
  </PageHero>
</Base>
