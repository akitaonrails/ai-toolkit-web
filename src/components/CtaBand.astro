---
// The closing call to action. The one centered thing on the site.
import { site } from '@/data/site';
import { blogHome } from '@/data/articles';
import { useI18n } from '@/i18n';
interface Props { title?: string; text?: string }
const { t, locale } = useI18n(Astro);
const { title = t('cta.title'), text = t('cta.text') } = Astro.props;
---
<section class="on-ink band text-center relative overflow-hidden motif motif-sunburst cta">
  <div class="wrap-narrow relative">
    <h2 class="text-3xl mx-auto max-w-[16em]">{title}</h2>
    <p class="lede mx-auto mt-5">{text}</p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <a href={site.github} class="btn btn-primary">{t('cta.github')}</a>
      <a href={blogHome(locale)} class="btn btn-ghost">{t('cta.blog')}</a>
    </div>
  </div>
</section>
<style>
  /* Brass rays rise behind the closing call, like the sunburst behind a fair's main gate. */
  .cta { --motif: color-mix(in oklab, var(--v-brass) 14%, var(--ink)); background-color: var(--ink); }
  .cta.motif-sunburst { --pattern: repeating-conic-gradient(from -90deg at 50% 120%, var(--motif) 0deg 4deg, transparent 4deg 9deg); }
</style>
