---
// Top of every detail page: the pavilion's entrance. The hero wears the page's pattern (its `motif`, drawn in the
// page's own color) and, when the pavilion has one, its poster standing in a brass deco arch. Slot: the buttons.
// Pavilions are declared in src/data/site.ts (`pavilions`); see docs/design-system.md, "Pavilions".
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Hue } from '@/data/site';
import { pavilions } from '@/data/site';
interface Props {
  hue: Hue;
  kicker: string;
  title: string;
  lede: string;
  pavilion?: string;
  art?: ImageMetadata;
  artAlt?: string;
  artFit?: 'cover' | 'contain';
}
const { hue, kicker, title, lede, pavilion, art, artAlt = '', artFit = 'cover' } = Astro.props;
const pav = pavilion ? pavilions[pavilion] : undefined;
// Posters are generated art (docs/images.md); a page whose poster is not drawn yet simply shows none.
const posters = import.meta.glob<{ default: ImageMetadata }>('/src/assets/img/gen/poster-*.webp', { eager: true });
const poster = pav && posters[`/src/assets/img/gen/${pav.poster}.webp`]?.default;
// A page may replace its generated pavilion poster with a real product or project image.
const visual = art ?? poster;
---
<section data-hue={hue} class:list={['page-hero', pav && ['motif', `motif-${pav.motif}`]]}>
  <div class="fair-lights" aria-hidden="true"><span class="fair-light"></span><span class="fair-light"></span><span class="fair-light"></span></div>
  <div class:list={['wrap pt-32 pb-12 md:pt-40 md:pb-16', visual && 'hero-grid']}>
    <div>
      <div class="kicker mb-6"><span class="dot" aria-hidden="true"></span>{kicker}</div>
      <h1 class="text-4xl max-w-[15em]" data-reveal>{title}</h1>
      <div class="rule mt-7" aria-hidden="true"></div>
      <p class="lede mt-7 !text-[1.3rem]">{lede}</p>
      {Astro.slots.has('default') && <div class="mt-9 flex flex-wrap gap-3"><slot /></div>}
    </div>
    {visual && (
      <div class:list={['arch', artFit === 'contain' && 'art-contained']} aria-hidden={artAlt ? undefined : 'true'}>
        <div class="arch-frame"><Image src={visual} alt={artAlt} widths={[360, 540, 720, 960]} sizes="(min-width: 1024px) 24rem, 70vw" loading="eager" /></div>
        <div class="arch-plinth"></div>
      </div>
    )}
  </div>
</section>
<style>
  .page-hero { position: relative; overflow: hidden; border-block-end: 5px double var(--hue-vivid, var(--v-brass)); }
  .page-hero > .wrap { position: relative; z-index: 1; }
  /* The pattern fades out under the text, so the title always sits on plain ground. */
  .page-hero.motif::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, var(--bg) 30%, color-mix(in oklab, var(--bg) 55%, transparent) 70%, transparent); pointer-events: none; }
  .hero-grid { display: grid; gap: 3rem; align-items: end; }
  @media (min-width: 64rem) { .hero-grid { grid-template-columns: 1.3fr 0.9fr; } }
  /* The deco arch: a round-topped doorway with three gilt frames, standing on a brass plinth. */
  .arch { justify-self: center; inline-size: min(22rem, 72vw); position: relative; margin-block-end: 1.1rem; filter: drop-shadow(0 1.5rem 2rem var(--shade)); }
  .arch::before, .arch::after { content: ''; position: absolute; z-index: -1; inset-block-end: -0.65rem; inline-size: 24%; block-size: 66%; border-block-start: 2px solid color-mix(in oklab, var(--v-brass) 72%, transparent); background: linear-gradient(90deg, transparent, color-mix(in oklab, var(--hue-vivid, var(--v-brass)) 12%, transparent)); }
  .arch::before { inset-inline-start: -14%; clip-path: polygon(100% 0, 100% 100%, 0 100%); }
  .arch::after { inset-inline-end: -14%; scale: -1 1; clip-path: polygon(100% 0, 100% 100%, 0 100%); }
  .arch-frame { aspect-ratio: 3 / 4; border-radius: 50% 50% 0.3rem 0.3rem / 34% 34% 0.3rem 0.3rem; overflow: hidden; border: 3px solid var(--v-brass); background: var(--ink); box-shadow: 0 0 0 5px var(--bg), 0 0 0 6px color-mix(in oklab, var(--v-brass) 60%, transparent), var(--shadow); }
  .arch-frame :global(img) { inline-size: 100%; block-size: 100%; object-fit: cover; display: block; }
  .art-contained { inline-size: min(25rem, 78vw); }
  .art-contained .arch-frame {
    aspect-ratio: 1 / 1;
    position: relative;
    border-radius: 48% 48% 0.45rem 0.45rem / 22% 22% 0.45rem 0.45rem;
    background:
      repeating-conic-gradient(from -18deg at 54% 61%, color-mix(in oklab, var(--hue-vivid, var(--v-brass)) 8%, transparent) 0deg 2deg, transparent 2deg 13deg),
      radial-gradient(circle at 54% 58%, color-mix(in oklab, var(--hue-vivid, var(--v-brass)) 24%, transparent), transparent 54%),
      linear-gradient(145deg, var(--ink-raised), var(--ink));
    box-shadow:
      inset 0 0 0 1px color-mix(in oklab, var(--v-brass) 35%, transparent),
      inset 0 -2.5rem 4rem color-mix(in oklab, var(--ink) 72%, transparent),
      0 0 0 5px var(--bg),
      0 0 0 6px color-mix(in oklab, var(--v-brass) 60%, transparent),
      0 1.3rem 3rem -1.4rem color-mix(in oklab, var(--hue-vivid, var(--v-brass)) 52%, var(--shade));
  }
  .art-contained .arch-frame::before {
    content: '';
    position: absolute;
    inset: 0.7rem;
    z-index: 0;
    border: 1px solid color-mix(in oklab, var(--v-brass) 48%, transparent);
    border-radius: inherit;
    pointer-events: none;
  }
  .art-contained .arch-frame :global(img) {
    position: relative;
    z-index: 1;
    object-fit: contain;
    padding: 0.2rem;
    filter: drop-shadow(0 1rem 0.8rem color-mix(in oklab, var(--ink) 55%, transparent));
  }
  .arch-plinth { position: absolute; inset: auto -7% -1.1rem; block-size: 1.1rem; background: var(--v-brass); clip-path: polygon(5% 0, 95% 0, 100% 100%, 0 100%); }
</style>
