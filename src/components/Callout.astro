---
// Limits and caveats.
import type { Hue } from '@/data/site';
// `level`: the heading level, for a callout that comes before the page's first h2.
interface Props { title: string; hue?: Hue; level?: 2 | 3 }
const { title, hue = 'red', level = 3 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
---
<aside data-hue={hue} class="rounded-[1.25rem] p-6 md:p-8 my-8" style="background:var(--hue-soft)">
  <Heading class="text-xl" style="color:var(--hue)">{title}</Heading>
  <div class="mt-3 prose-site"><slot /></div>
</aside>
