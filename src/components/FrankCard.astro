---
// One Frank project on /frank/: README screenshot, name, stack, what it does, why I built it, posts, stars.
// `small` is the compact version used for the smaller projects.
import { Image } from 'astro:assets';
import RepoMeta from './RepoMeta.astro';
import { articles, articleUrl } from '@/data/articles';
import { repoUrl } from '@/data/site';
import type { FrankProject } from '@/data/frank';
import { useI18n } from '@/i18n';
interface Props { project: FrankProject; shot: ImageMetadata; small?: boolean }
const { project: p, shot, small } = Astro.props;
const { t, locale } = useI18n(Astro, 'frank');
const { t: ta } = useI18n(Astro, 'articles');
---
<li class:list={['frank-card', small && 'is-small']}>
  <a href={repoUrl(p.repo)} class="frank-shot" dir="ltr" tabindex="-1" aria-hidden="true">
    <Image src={shot} alt="" widths={[480, 800, 1200].filter((w) => w <= shot.width)} sizes={small ? '(min-width: 1024px) 24rem, (min-width: 640px) 46vw, 94vw' : '(min-width: 1024px) 36rem, 94vw'} quality={82} class="w-full h-full object-cover object-top" />
  </a>
  <div class="frank-body">
    <h3 class={small ? 'text-xl' : 'text-2xl'}><a href={repoUrl(p.repo)}>{t(`projects.items.${p.id}.name`)}</a></h3>
    <p class="font-mono text-xs text-muted" dir="ltr">{p.stack}</p>
    <p class:list={['text-muted', small && 'text-sm']}>{t(`projects.items.${p.id}.text`)}</p>
    <p class="text-sm"><span class="font-semibold">{t('projects.itch')}</span> <span class="text-muted">{t(`projects.items.${p.id}.itch`)}</span></p>
    {p.posts.length > 0 && (
      <ul class="grid gap-1 text-sm mt-1">
        {p.posts.map((id) => <li><a class="link" href={articleUrl({ id, ...articles[id] }, locale)}>{ta(`items.${id}.title`)}</a></li>)}
      </ul>
    )}
    <div class="mt-auto pt-3"><RepoMeta id={p.repo} /></div>
  </div>
</li>
<style>
  .frank-card { display: flex; flex-direction: column; border: 1.5px solid var(--line); border-radius: var(--radius); background: var(--surface); overflow: hidden; }
  .frank-shot { display: block; aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 1px solid var(--line); background: var(--ink); }
  .frank-body { display: flex; flex-direction: column; gap: 0.75rem; flex-grow: 1; padding: 1.5rem; }
  @media (min-width: 768px) { .frank-card:not(.is-small) .frank-body { padding: 1.75rem; } }
  .is-small .frank-body { padding: 1.25rem; gap: 0.6rem; }
  h3 a { text-decoration-color: var(--hue-vivid); text-underline-offset: 0.2em; }
  h3 a:hover { text-decoration-line: underline; }
</style>
