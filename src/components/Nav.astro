---
import { nav, site, toolIds, externalTools } from '@/data/site';
import { useI18n, languageLinks } from '@/i18n';
import { locales } from '@/i18n/config';
const { t, href, locale } = useI18n(Astro);
const path = Astro.url.pathname;
const languages = languageLinks(path);
// The language menu appears once there is a second language to pick.
const multilingual = languages.length > 1;
// The top bar groups the tool pages under one menu; the drawer lists them under a heading.
const tools = nav.filter((l) => toolIds.includes(l.id));
const firstTool = nav.findIndex((l) => toolIds.includes(l.id));
const onTool = tools.some((l) => path === href(l.href));
---
<header class="site-nav" data-nav>
  <div class="wrap flex h-16 items-center gap-5">
    <a href={href('/')} class="wordmark shrink-0" aria-label={t('a11y.home')}>
      <span class="dot" aria-hidden="true"></span>
      <span>Akita's AI Toolkit</span>
    </a>
    <nav class="hidden xl:flex items-center gap-0.5 ms-3" aria-label={t('a11y.mainNav')}>
      {nav.map((l, i) => toolIds.includes(l.id) ? (i === firstTool && (
        <div class="relative" data-menu>
          <button type="button" class="nav-link inline-flex items-center gap-1" data-menu-trigger aria-expanded="false" aria-haspopup="true" data-current={onTool ? '' : undefined}>
            {t('nav.tools.label')}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="menu-panel tools-panel" role="group" aria-label={t('nav.tools.label')}>
            {tools.map((tool) => (
              <a href={href(tool.href)} data-hue={tool.hue} class="tool-item" aria-current={path === href(tool.href) ? 'page' : undefined}>
                <span class="dot" aria-hidden="true"></span>
                <span><span class="block font-display font-bold">{t(`nav.${tool.id}.label`)}</span><span class="block text-sm text-muted">{t(`nav.${tool.id}.note`)}</span></span>
              </a>
            ))}
            <span class="menu-sep" aria-hidden="true"></span>
            {externalTools.map((tool) => (
              <a href={tool.href} data-hue={tool.hue} class="tool-item" aria-label={`${t(`nav.${tool.id}.label`)} (${t('a11y.external')})`}>
                <span class="dot" aria-hidden="true"></span>
                <span><span class="flex items-center gap-1.5 font-display font-bold">{t(`nav.${tool.id}.label`)}<svg class="ext" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg></span><span class="block text-sm text-muted">{t(`nav.${tool.id}.note`)}</span></span>
              </a>
            ))}
          </div>
        </div>
      )) : <a href={href(l.href)} data-hue={l.hue} class="nav-link" aria-current={path === href(l.href) ? 'page' : undefined}>{t(`nav.${l.id}.label`)}</a>)}
    </nav>
    <div class="ms-auto flex items-center gap-1.5">
      <a href={site.github} class="icon-btn" aria-label="GitHub">
        <svg width="19" height="19" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
      </a>
      {multilingual && <div class="relative" data-menu>
        <button type="button" class="icon-btn" data-menu-trigger aria-expanded="false" aria-haspopup="true" aria-label={`${t('a11y.language')}: ${locales[locale].label}`}>
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.500 5.6 12 3Z"/></svg>
        </button>
        <div class="menu-panel" role="group" aria-label={t('a11y.language')}>
          {languages.map((l) => <a href={l.url} hreflang={l.htmlLang} lang={l.htmlLang} dir={l.dir} data-set-lang={l.code} aria-current={l.code === locale ? 'true' : undefined}>{l.label}</a>)}
        </div>
      </div>}
      <button type="button" class="icon-btn" data-theme-toggle aria-label={t('a11y.toggleTheme')}>
        <svg class="hidden dark:block" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.900 4.900l1.400 1.400M17.700 17.700l1.400 1.400M2 12h2M20 12h2M4.900 19.100l1.400-1.400M17.700 6.300l1.400-1.400"/></svg>
        <svg class="dark:hidden" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.500A8 8 0 0 1 9.500 4a8 8 0 1 0 10.500 10.500Z"/></svg>
      </button>
      <a href={href('/#follow')} class="btn btn-primary hidden md:inline-flex !py-2 !px-4 !text-[0.95rem] ms-1.5">{t('nav.follow.label')}</a>
      <button type="button" class="icon-btn xl:!hidden" data-drawer-open aria-label={t('a11y.openMenu')} aria-controls="drawer">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>

<dialog id="drawer" class="drawer" aria-label={t('a11y.menu')}>
  <div class="flex items-center justify-between h-16 px-5">
    <span class="font-display text-xl font-bold">{t('a11y.menu')}</span>
    <button type="button" class="icon-btn" data-drawer-close aria-label={t('a11y.closeMenu')}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </div>
  <div class="px-5 pb-10 grid gap-1">
    {nav.map((l, i) => (
      <Fragment>
      {i === firstTool && <span class="drawer-group">{t('nav.tools.label')}</span>}
      <a href={href(l.href)} data-hue={l.hue} class:list={['drawer-link', toolIds.includes(l.id) && 'drawer-sub']}>
        <span class="dot" aria-hidden="true"></span>
        <span><span class="block font-display font-bold text-lg leading-tight">{t(`nav.${l.id}.label`)}</span><span class="block text-sm text-muted">{t(`nav.${l.id}.note`)}</span></span>
      </a>
      {i === firstTool + tools.length - 1 && externalTools.map((tool) => (
        <a href={tool.href} data-hue={tool.hue} class="drawer-link drawer-sub">
          <span class="dot" aria-hidden="true"></span>
          <span><span class="flex items-center gap-1.5 font-display font-bold text-lg leading-tight">{t(`nav.${tool.id}.label`)}<svg class="ext" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg></span><span class="block text-sm text-muted">{t(`nav.${tool.id}.note`)}</span></span>
        </a>
      ))}
      {i === firstTool + tools.length - 1 && <span class="drawer-rule" aria-hidden="true"></span>}
      </Fragment>
    ))}
    <a href={href('/#follow')} class="btn btn-primary mt-5">{t('nav.follow.label')}</a>
  </div>
</dialog>

<style is:global>
  .site-nav { position: fixed; inset-inline: 0; top: 0; z-index: 50; transition: background 0.3s, border-color 0.3s; border-block-end: 1px solid transparent; }
  .site-nav[data-scrolled] { background: color-mix(in oklch, var(--bg) 82%, transparent); backdrop-filter: blur(14px) saturate(1.4); border-color: var(--line); }
  .wordmark { display: inline-flex; align-items: center; gap: 0.65rem; font-family: var(--font-display); font-weight: 800; font-stretch: 110%; font-size: 1.12rem; letter-spacing: -0.01em; }
  .wordmark .dot { inline-size: 0.6rem; block-size: 0.6rem; }
  .nav-link { padding: 0.45rem 0.8rem; border-radius: 99px; font-weight: 600; font-size: 0.97rem; color: var(--muted); transition: color 0.2s, background 0.2s; }
  .nav-link:hover, .nav-link[aria-current] { color: var(--hue); background: var(--hue-soft); }
  button.nav-link:hover, button.nav-link[data-current], [data-menu][data-open] > button.nav-link { color: var(--text); background: var(--tint); }
  [data-menu][data-open] > button.nav-link svg { transform: rotate(180deg); }
  button.nav-link svg { transition: transform 0.2s; }
  .menu-panel.tools-panel { inset-inline-end: auto; inset-inline-start: 0; min-width: 20rem; gap: 0.15rem; }
  .tools-panel .tool-item { display: grid; grid-template-columns: auto 1fr; gap: 0.8rem; align-items: center; padding: 0.65rem 0.8rem; }
  .tools-panel .tool-item[aria-current] { background: var(--hue-soft); color: var(--text); font-weight: 400; }
  .menu-sep { display: block; block-size: 1px; margin: 0.3rem 0.6rem; background: var(--line); }
  .ext { color: var(--muted); flex: none; }
  .drawer-group { margin-block-start: 0.8rem; padding-inline: 0.6rem; font-family: var(--font-mono); font-size: var(--text-sm); color: var(--muted); }
  .drawer-link.drawer-sub { padding-inline-start: 1.4rem; }
  .drawer-rule { display: block; block-size: 1px; margin: 0.6rem 0.6rem; background: var(--line); }
  .icon-btn { display: inline-grid; place-items: center; inline-size: 2.5rem; block-size: 2.5rem; border-radius: 99px; color: var(--muted); transition: color 0.2s, background 0.2s; }
  .icon-btn:hover { color: var(--text); background: var(--tint); }
  .menu-panel { position: absolute; inset-inline-end: 0; top: calc(100% + 0.5rem); min-width: 12rem; padding: 0.4rem; background: var(--surface); border: 1.5px solid var(--line); border-radius: 1rem; box-shadow: var(--shadow); display: none; }
  [data-menu][data-open] .menu-panel { display: grid; }
  .menu-panel a { padding: 0.5rem 0.8rem; border-radius: 0.65rem; }
  .menu-panel a:hover { background: var(--tint); }
  .menu-panel a[aria-current] { color: var(--green); font-weight: 700; }
  .drawer { margin: 0; margin-inline-start: auto; inline-size: min(24rem, 100%); max-inline-size: none; block-size: 100dvh; max-block-size: none; background: var(--bg); color: var(--text); border-inline-start: 1.5px solid var(--line); }
  .drawer::backdrop { background: var(--veil); backdrop-filter: blur(4px); }
  .drawer-link { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: center; padding: 0.8rem 0.6rem; border-radius: 1rem; }
  .drawer-link:hover { background: var(--tint); }
</style>
