---
// The home page portrait, standing in the fair's brass deco arch: a round-topped doorway with gilt frames on a
// plinth, the same arch the pavilion posters stand in (PageHero). The source is transparent (docs/images.md, "Portrait").
import { Image } from 'astro:assets';
import portrait from '@/assets/img/portrait/akita.png';
interface Props { alt: string }
const { alt } = Astro.props;
---
<div class="portrait">
  <div class="frame">
    <Image src={portrait} alt={alt} widths={[360, 540, 720, 1080]} sizes="(min-width: 1024px) 26rem, 76vw" loading="eager" fetchpriority="high" class="face" />
  </div>
  <div class="plinth" aria-hidden="true"></div>
</div>
<style>
  .portrait { position: relative; inline-size: min(26rem, 76vw); margin-inline: auto; margin-block-end: 1.2rem; }
  /* Behind the face, a soft patina glow like the glass of an undersea dome. */
  .frame { position: relative; aspect-ratio: 3 / 4; overflow: hidden; border: 3px solid var(--v-brass); border-radius: 50% 50% 0.3rem 0.3rem / 36% 36% 0.3rem 0.3rem;
    background: radial-gradient(circle at 50% 38%, color-mix(in oklab, var(--v-patina) 45%, var(--ink-raised)), var(--ink) 68%);
    box-shadow: 0 0 0 5px var(--bg), 0 0 0 6px color-mix(in oklab, var(--v-brass) 60%, transparent), var(--shadow); }
  .frame::before, .frame::after { content: ''; position: absolute; inset: 10px; border-radius: inherit; border: 1px solid color-mix(in oklab, var(--v-brass) 55%, transparent); z-index: 1; pointer-events: none; }
  .frame::after { inset: 20px; }
  .face { position: absolute; inset-inline: 0; bottom: 0; inline-size: 100%; block-size: auto; filter: drop-shadow(0 18px 30px var(--shade)); }
  .plinth { position: absolute; inset: auto -7% -1.2rem; block-size: 1.2rem; background: var(--v-brass); clip-path: polygon(5% 0, 95% 0, 100% 100%, 0 100%); }
</style>
