---
// Reads the book on the page with epub.js (github.com/futurepress/epub.js). The EPUBs are unpacked into
// /book/read/<edition>/ at build time (scripts/fetch-book.mjs), so the reader fetches one chapter at a time.
// In the card it shows one page; full screen shows two pages side by side when the screen is wide enough.
// Pages turn with the buttons, the arrow keys, a swipe, or a tap or click on the page's outer third, like an e-reader.
// epub.js loads only when the card comes near the screen. Pages take the site's own colors (light or dark).
// It resumes where the reader stopped: the last edition opened and the last page of each, kept in this browser's
// localStorage (nothing leaves the browser; a private window simply starts at the cover). Words in book.json `reader`.
import { useI18n } from '@/i18n';
import { book, bookEdition } from '@/data/book';
const { t, locale } = useI18n(Astro, 'book');
const first = bookEdition(locale);
---
<div class="reader" data-reader data-default={first} data-label-full={t('reader.full')} data-label-exit={t('reader.exit')}>
  <div class="bar">
    <div class="editions" role="group" aria-label={t('reader.edition')}>
      {book.editions.map((e) => <button type="button" data-edition={e.id} aria-pressed={e.id === first ? 'true' : 'false'}>{t(`reader.editions.${e.id}`)}</button>)}
    </div>
    <label class="toc"><span class="sr-only">{t('reader.contents')}</span>
      <select data-toc disabled><option value="">{t('reader.contents')}</option></select>
    </label>
    <button type="button" class="ctl" data-fs aria-label={t('reader.full')}>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path class="i-full" d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /><path class="i-exit" d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" /></svg>
    </button>
  </div>
  <div class="stage">
    <button type="button" class="turn" data-prev aria-label={t('reader.prev')}>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
    </button>
    <div class="view" data-view dir="ltr" tabindex="0" aria-label={t('reader.label')}>
      <p class="status" data-status data-loading={t('reader.loading')} data-error={t('reader.error')}>{t('reader.loading')}</p>
    </div>
    <button type="button" class="turn" data-next aria-label={t('reader.next')}>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
    </button>
  </div>
  <p class="where" data-where aria-live="polite"></p>
</div>

<style>
  .reader { display: flex; flex-direction: column; gap: 0.75rem; padding: 1rem; border-radius: 1.25rem; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow); block-size: min(46rem, 82svh); }
  .reader:fullscreen, .reader.max { block-size: 100%; border-radius: 0; border: 0; padding: 1rem 1.5rem; background: var(--bg); }
  .reader.max { position: fixed; inset: 0; z-index: 100; block-size: 100svh; }
  .bar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .editions { display: flex; gap: 0.25rem; padding: 0.2rem; border-radius: 99px; background: var(--tint, var(--bg)); }
  .editions button { padding: 0.45rem 0.9rem; border-radius: 99px; font-size: var(--text-sm); font-weight: 600; color: var(--muted); min-block-size: 2.5rem; }
  .editions button[aria-pressed='true'] { background: var(--surface); color: var(--text); box-shadow: 0 0 0 1.5px var(--hue-vivid); }
  .toc { flex: 1 1 12rem; min-inline-size: 0; }
  .toc select { inline-size: 100%; min-block-size: 2.5rem; padding-inline: 0.75rem; border-radius: 0.75rem; border: 1px solid var(--line); background: var(--surface); color: var(--text); font-size: var(--text-sm); }
  .ctl { display: grid; place-items: center; inline-size: 2.5rem; block-size: 2.5rem; border-radius: 99px; border: 1.5px solid var(--line); color: var(--text); }
  .ctl:hover { border-color: var(--muted); }
  .ctl .i-exit, .reader:fullscreen .ctl .i-full, .reader.max .ctl .i-full { display: none; }
  .reader:fullscreen .ctl .i-exit, .reader.max .ctl .i-exit { display: inline; }
  .stage { flex: 1; min-block-size: 0; display: grid; grid-template-columns: auto 1fr auto; grid-template-rows: minmax(0, 1fr); gap: 0.5rem; }
  .view { touch-action: pan-y pinch-zoom; overscroll-behavior-x: contain; block-size: 100%; min-inline-size: 0; inline-size: 100%; position: relative; border-radius: 0.5rem; justify-self: center; }
  /* In the card, one page at a readable width; full screen gets the whole width for two pages. */
  .reader:not(:fullscreen, .max) .view { max-inline-size: 42rem; }
  .view:focus-visible { outline: 2px solid var(--action); outline-offset: 2px; }
  .turn { display: grid; place-items: center; align-self: center; inline-size: 2.75rem; block-size: 4.5rem; border-radius: 0.75rem; color: var(--muted); }
  .turn:hover { color: var(--text); background: var(--tint, var(--bg)); }
  .status { position: absolute; inset: 0; display: grid; place-items: center; color: var(--muted); text-align: center; padding: 1rem; }
  .where { min-block-size: 1.4em; font-family: var(--font-mono); font-size: var(--text-sm); color: var(--muted); text-align: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  @media (max-width: 40rem) {
    .reader { padding: 0.75rem; }
    .stage { grid-template-columns: 1fr; }
    .turn { display: none; }
  }
</style>

<script>
  type Rendition = import('epubjs').Rendition;
  type Book = import('epubjs').Book;
  type NavItem = import('epubjs').NavItem;

  const root = document.querySelector<HTMLElement>('[data-reader]');
  if (root) {
    const view = root.querySelector<HTMLElement>('[data-view]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const toc = root.querySelector<HTMLSelectElement>('[data-toc]')!;
    const where = root.querySelector<HTMLElement>('[data-where]')!;
    const fsButton = root.querySelector<HTMLButtonElement>('[data-fs]')!;
    const editionButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-edition]')];
    const store = {
      get: (k: string) => { try { return localStorage.getItem(k); } catch { return null; } },
      set: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* private mode: no memory */ } },
    };
    const wide = () => document.fullscreenElement === root || root.classList.contains('max');
    // The pages take the site's colors, so the book follows the light or dark theme.
    const colors = () => { const s = getComputedStyle(view); return { bg: s.getPropertyValue('--surface').trim(), fg: s.getPropertyValue('--text').trim(), link: s.getPropertyValue('--hue').trim() }; };

    let ePub: typeof import('epubjs').default;
    // Resume where the reader stopped: the last edition opened, and the last page of each edition (an EPUB CFI).
    const editions = editionButtons.map((b) => b.dataset.edition!);
    const saved = store.get('book-edition');
    let book: Book | undefined, rendition: Rendition | undefined, labels = new Map<string, string>();
    let edition = saved && editions.includes(saved) ? saved : root.dataset.default!;

    const paint = () => {
      if (!rendition) return;
      const c = colors();
      rendition.themes.override('background', c.bg);
      rendition.themes.override('color', c.fg);
      // Links in the page's accent, readable on both themes (the EPUB leaves them in the browser's default blue).
      rendition.themes.default({
        a: { color: `${c.link} !important` },
        // Horizontal swipes belong to the reader: without this, a swipe to the right can trigger the browser's own
        // back gesture and leave the page (Chrome on Android).
        'html, body': { 'touch-action': 'pan-y pinch-zoom', 'overscroll-behavior-x': 'none' },
      });
    };
    // Draws the loaded book into the card (one page) or the full screen (two pages when wide enough), at `at`.
    // epub.js keeps already-drawn pages at their old size after a resize, so a layout change draws them anew.
    // Each draw has a number: a newer one (the size changed again) wins, and an older one stops quietly.
    let drawn = 0;
    async function render(id: string, at?: string) {
      const mine = ++drawn;
      rendition?.destroy();
      rendition = book!.renderTo(view, { width: '100%', height: '100%', flow: 'paginated', spread: wide() ? 'auto' : 'none', minSpreadWidth: 900, allowScriptedContent: false });
      paint();
      rendition.on('relocated', (loc: { start: { cfi: string; href: string } }) => {
        store.set(`book-cfi-${id}`, loc.start.cfi);
        const file = loc.start.href.split('#')[0];
        where.textContent = labels.get(file) ?? '';
        const match = [...toc.options].find((o) => o.value && o.value.split('#')[0] === file);
        if (match) toc.value = match.value;
      });
      rendition.on('keyup', key);
      let x0 = 0;
      rendition.on('touchstart', (e: TouchEvent) => { x0 = e.changedTouches[0].screenX; });
      rendition.on('touchend', (e: TouchEvent) => { const dx = e.changedTouches[0].screenX - x0; if (Math.abs(dx) > 40) (dx < 0 ? rendition!.next() : rendition!.prev()); });
      // Tap or click the outer third of the page to turn it, like an e-reader; links and the middle are left alone.
      rendition.on('click', (e: MouseEvent) => {
        const target = e.target as Element;
        if (target.closest?.('a') || target.ownerDocument.getSelection()?.toString()) return;
        // The chapter iframe is as wide as all its pages, so place the click in the visible view, in page coordinates.
        const frame = target.ownerDocument.defaultView?.frameElement?.getBoundingClientRect();
        if (!frame) return;
        const r = view.getBoundingClientRect();
        const x = (frame.left + e.clientX - r.left) / r.width;
        if (x > 2 / 3) rendition!.next(); else if (x < 1 / 3) rendition!.prev();
      });
      const r = rendition;
      try {
        await r.display(at);
      } catch (err) {
        if (mine !== drawn) return;
        // A saved page that no longer exists (a new version of the book) opens at the start instead of a blank view.
        if (!at) throw err;
        await r.display();
      }
    }
    const fit = () => {
      if (!rendition) return;
      const at = (rendition.currentLocation() as unknown as { start?: { cfi: string } })?.start?.cfi;
      render(edition, at ?? store.get(`book-cfi-${edition}`) ?? undefined).catch((err) => {
        console.error(err);
        status.hidden = false; status.textContent = status.dataset.error!;
      });
    };
    // Draw again once the view settles on a new size. Entering full screen resizes it several times while the
    // browser animates (macOS), so wait until it stops changing instead of measuring the first frame.
    let size = '', settle: ReturnType<typeof setTimeout> | undefined;
    new ResizeObserver(([e]) => {
      const next = `${Math.round(e.contentRect.width)}x${Math.round(e.contentRect.height)}`;
      if (next === size) return;
      const first = !size; size = next;
      if (first) return;
      clearTimeout(settle); settle = setTimeout(fit, 200);
    }).observe(view);

    async function open(id: string) {
      edition = id; store.set('book-edition', id);
      editionButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.edition === id)));
      rendition?.destroy(); rendition = undefined; book?.destroy();
      status.hidden = false; status.textContent = status.dataset.loading!; toc.disabled = true; where.textContent = '';
      try {
        book = ePub(`/book/read/${id}/`);
        const nav = await book.loaded.navigation;
        labels = new Map(); toc.replaceChildren(toc.options[0]);
        const add = (items: NavItem[], depth: number) => items.forEach((it) => {
          labels.set(it.href.split('#')[0], it.label.trim());
          toc.add(new Option(`${'  '.repeat(depth)}${it.label.trim()}`, it.href));
          if (it.subitems?.length && depth < 1) add(it.subitems, depth + 1);
        });
        add(nav.toc, 0);
        toc.disabled = false;
        await render(id, store.get(`book-cfi-${id}`) ?? undefined);
        status.hidden = true;
      } catch (err) {
        console.error(err);
        status.hidden = false; status.textContent = status.dataset.error!;
      }
    }

    function key(e: KeyboardEvent) {
      if (e.key === 'ArrowRight' || e.key === 'PageDown') rendition?.next();
      if (e.key === 'ArrowLeft' || e.key === 'PageUp') rendition?.prev();
    }
    view.addEventListener('keyup', key);
    root.querySelector('[data-prev]')!.addEventListener('click', () => rendition?.prev());
    root.querySelector('[data-next]')!.addEventListener('click', () => rendition?.next());
    toc.addEventListener('change', () => { if (toc.value) rendition?.display(toc.value); });
    editionButtons.forEach((b) => b.addEventListener('click', () => { if (b.dataset.edition !== edition) open(b.dataset.edition!); }));

    // Full screen: the real thing where the browser allows it, a fixed overlay where it doesn't (iPhone Safari).
    const label = () => fsButton.setAttribute('aria-label', wide() ? root.dataset.labelExit! : root.dataset.labelFull!);
    fsButton.addEventListener('click', async () => {
      if (document.fullscreenEnabled) {
        if (document.fullscreenElement) await document.exitFullscreen(); else await root.requestFullscreen();
      } else {
        root.classList.toggle('max'); document.documentElement.style.overflow = root.classList.contains('max') ? 'hidden' : '';
        label();
      }
    });
    document.addEventListener('fullscreenchange', label);
    root.addEventListener('keyup', (e) => { if (e.key === 'Escape' && root.classList.contains('max')) fsButton.click(); });
    // Follow the site's theme switch.
    new MutationObserver(paint).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme', 'class'] });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', paint);

    // Load epub.js and the book only when the card is about to be seen.
    const io = new IntersectionObserver(async (entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      ePub = (await import('epubjs')).default;
      open(edition);
    }, { rootMargin: '400px' });
    io.observe(root);
  }
</script>
