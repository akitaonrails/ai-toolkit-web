---
// The fair map: the site's directory drawn as a 1960s fairground. Every pavilion is a link to its page, walkways
// lead out from Plaza 42 (where to follow me) in the middle, a monorail loops around it and a lagoon runs along the
// bottom. Drawn in code, so labels come from home.json `map` and every language is exact. On narrow screens the
// map scrolls sideways and opens centered on the plaza. Colors are the pavilions' own (src/data/site.ts).
import { useI18n } from '@/i18n';
const { t, href } = useI18n(Astro, 'home');
const L = (k: string) => t(`map.places.${k}.name`);
const S = (k: string) => t(`map.places.${k}.note`);
---
<div class="fair-map">
  <div class="map-scroll" data-map dir="ltr">
    <svg viewBox="0 0 1200 640" role="img" aria-labelledby="fair-map-desc">
      <title id="fair-map-desc">{t('map.alt')}</title>
      <g class="waves" aria-hidden="true">
        <path d="M0 590 q 25 -12 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0" />
        <path d="M-25 612 q 25 -12 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0" />
        <path d="M0 634 q 25 -12 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0" />
      </g>
      <ellipse class="rail" cx="600" cy="300" rx="310" ry="150" aria-hidden="true" />
      <g class="walks" aria-hidden="true">
        <path d="M600 300 L 600 120 M600 300 L 245 165 M600 300 L 955 165 M600 300 L 200 330 M600 300 L 1000 330 M600 300 L 230 470 M600 300 L 970 470 M600 300 L 600 500" />
      </g>

      <a href={href('/book/')} data-hue="jade">
        <path class="pav" d="M560 125 V 62 L 575 48 V 24 L 600 6 L 625 24 V 48 L 640 62 V 125 Z" />
        <path class="fin" d="M552 125 L 560 70 L 560 125Z M648 125 L 640 70 L 640 125Z" />
        <text class="name" x="662" y="62">{L('book')}</text><text class="note" x="662" y="82">{S('book')}</text>
      </a>
      <a href={href('/agi/')} data-hue="pennant"><path class="pav" d="M140 190 V 142 A 24 24 0 0 1 188 142 V 190 Z" /></a>
      <a href={href('/limits/')} data-hue="cerulean"><path class="pav" d="M193 190 V 128 A 29 29 0 0 1 251 128 V 190 Z" /></a>
      <a href={href('/students/')} data-hue="jade"><path class="pav" d="M256 190 V 142 A 24 24 0 0 1 304 142 V 190 Z" /></a>
      <text class="name" x="140" y="220">{L('opinions')}</text><text class="note" x="140" y="240">{S('opinions')}</text>
      <a href={href('/#tools')} data-hue="cerulean">
        <path class="pav" d="M885 190 V 168 A 70 60 0 0 1 1025 168 V 190 Z" /><circle class="core" cx="955" cy="152" r="15" />
        <text class="name" x="885" y="220">{L('machines')}</text><text class="note" x="885" y="240">{S('machines')}</text>
      </a>
      <a href={href('/workflow/')} data-hue="amethyst">
        <path class="pav" d="M120 360 V 312 L 155 292 V 312 L 190 292 V 312 L 225 292 V 312 L 260 292 V 360 Z" />
        <text class="name" x="120" y="390">{L('workshop')}</text><text class="note" x="120" y="410">{S('workshop')}</text>
      </a>
      <a href={href('/podcasts/')} data-hue="jade">
        <path class="pav" d="M1000 400 L 1010 270 L 1020 400 Z" /><ellipse class="pav" cx="1010" cy="280" rx="44" ry="10" /><path class="fin" d="M1009 232 h2 v40 h-2z" />
        <text class="name" x="1062" y="330" text-anchor="start">{L('broadcast')}</text><text class="note" x="1062" y="350">{S('broadcast')}</text>
      </a>
      <a href={href('/newsletter/')} data-hue="mauve">
        <path class="pav" d="M930 510 V 470 L 970 448 L 1010 470 V 510 Z" /><path class="fin" d="M950 490 h40 v6 h-40z" />
        <text class="name" x="1022" y="478">{L('press')}</text><text class="note" x="1022" y="498">{S('press')}</text>
      </a>
      <a href={href('/setup/')} data-hue="patina">
        <rect class="pav" x="190" y="452" width="80" height="48" rx="4" /><rect class="core" x="202" y="462" width="24" height="16" /><rect class="core" x="234" y="462" width="24" height="16" />
        <text class="name" x="80" y="530">{L('control')}</text><text class="note" x="80" y="550">{S('control')}</text>
      </a>
      <a href={href('/games/')} data-hue="copper">
        <circle class="pav" cx="600" cy="510" r="32" /><circle class="core" cx="600" cy="510" r="13" />
        <text class="name" x="648" y="505">{L('arcade')}</text><text class="note" x="648" y="525">{S('arcade')}</text>
      </a>
      <a href={href('/#follow')}>
        <circle class="plaza" cx="600" cy="300" r="56" />
        <text class="plaza-num" x="600" y="317" text-anchor="middle">42</text>
        <text class="note" x="600" y="380" text-anchor="middle">{L('plaza')}</text>
      </a>
      <g class="flags" aria-hidden="true"><path d="M360 570 v-40 l18 8 -18 8z" /><path d="M420 570 v-40 l18 8 -18 8z" /><path d="M780 570 v-40 l18 8 -18 8z" /><path d="M840 570 v-40 l18 8 -18 8z" /></g>
    </svg>
  </div>
  <p class="map-note">{t('map.note')}</p>
</div>

<style>
  .fair-map { margin-block-start: 1rem; }
  .map-scroll { overflow-x: auto; background: var(--ink); border: 2px solid var(--v-brass); border-radius: var(--radius); box-shadow: 0 0 0 4px var(--bg), 0 0 0 5px color-mix(in oklab, var(--v-brass) 55%, transparent); padding: clamp(0.4rem, 2vw, 1.2rem); }
  svg { display: block; inline-size: 100%; min-inline-size: 46rem; block-size: auto; }
  .waves path { fill: none; stroke: color-mix(in oklab, var(--v-patina) 55%, transparent); stroke-width: 2; }
  .rail { fill: none; stroke: var(--v-brass); stroke-width: 2; stroke-dasharray: 14 8; opacity: 0.6; }
  .walks path { fill: none; stroke: color-mix(in oklab, var(--v-patina) 50%, var(--ink)); stroke-width: 13; stroke-linecap: round; }
  .pav { fill: var(--ink-raised); stroke: var(--hue-vivid, var(--v-brass)); stroke-width: 2.5; transition: fill 0.2s; }
  .fin { fill: var(--hue-vivid, var(--v-brass)); }
  .core { fill: var(--hue-vivid, var(--v-brass)); }
  .name { font: 700 17px var(--font-sign); fill: var(--on-ink); }
  .note { font: 400 13.5px var(--font-sign); fill: var(--on-ink-muted); }
  a:hover .pav, a:focus-visible .pav { fill: color-mix(in oklab, var(--hue-vivid, var(--v-brass)) 30%, var(--ink-raised)); }
  a:hover .name, a:focus-visible .name { fill: var(--v-brass); }
  a:focus-visible { outline: none; }
  .plaza { fill: var(--v-pennant); stroke: var(--on-ink); stroke-width: 3; }
  .plaza-num { font: 46px var(--font-display); fill: var(--on-ink); }
  .flags path { fill: var(--v-pennant); }
  .map-note { margin-block-start: 1rem; color: var(--muted); font-size: var(--text-sm); font-style: italic; }
  @media (min-width: 48rem) { .map-note { display: none; } }
</style>

<script>
  // On narrow screens the map scrolls sideways: open it centered on Plaza 42.
  for (const m of document.querySelectorAll<HTMLElement>('[data-map]')) {
    if (m.scrollWidth > m.clientWidth) m.scrollLeft = (m.scrollWidth - m.clientWidth) / 2;
  }
</script>
