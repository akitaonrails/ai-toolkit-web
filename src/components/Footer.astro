---
import { nav, extras, site, social, sisters, repoUrl } from '@/data/site';
import { useI18n, languageLinks } from '@/i18n';
const { t, href, locale } = useI18n(Astro);
const languages = languageLinks(Astro.url.pathname);
---
<footer class="border-t border-line">
  <div class="spectrum-rule !rounded-none" aria-hidden="true"></div>
  <div class="wrap py-14 grid gap-10 md:grid-cols-[1.5fr_1fr_1fr_1fr]">
    <div>
      <a href={href('/')} class="wordmark"><span class="dot" aria-hidden="true"></span><span>Akita's AI Toolkit</span></a>
      <p class="mt-3 text-muted max-w-[26em]">{t('footer.about')}</p>
    </div>
    <nav aria-label={t('footer.tools')} class="grid gap-2 content-start">
      <span class="font-display font-bold">{t('footer.tools')}</span>
      {[...nav, ...extras].map((l) => <a href={href(l.href)} class="hover:text-text text-muted">{t(`nav.${l.id}.label`)}</a>)}
    </nav>
    <div class="grid gap-2 content-start">
      <span class="font-display font-bold">{t('footer.sisters')}</span>
      <a href={sisters.memory.url} class="hover:text-text text-muted">ai-memory</a>
      <a href={sisters.jail.url} class="hover:text-text text-muted">ai-jail</a>
      <a href={repoUrl('skills')} class="hover:text-text text-muted">my-skills</a>
    </div>
    <div class="grid gap-2 content-start">
      <span class="font-display font-bold">{t('footer.more')}</span>
      {social.map((s) => <a href={s.url} class="hover:text-text text-muted" rel="me">{t(`social.${s.id}.name`)}</a>)}
    </div>
  </div>
  <div class="wrap pb-10 flex flex-wrap gap-x-6 gap-y-3 items-center text-sm text-muted">
    <span>{t('footer.by')} <a class="link" href={site.authorUrl}>{site.author}</a></span>
    <a href="#" data-consent-open class="hover:text-text">{t('footer.cookieSettings')}</a>
    {languages.length > 1 && (
      <span class="flex flex-wrap gap-x-3 gap-y-1">
        {languages.map((l) => <a href={l.url} hreflang={l.htmlLang} lang={l.htmlLang} data-set-lang={l.code} class:list={['hover:text-text', l.code === locale && 'text-text font-semibold']}>{l.label}</a>)}
      </span>
    )}
    <span class="flex gap-1 ms-auto" role="group" aria-label={t('a11y.toggleTheme')}>
      {(['system', 'light', 'dark'] as const).map((m) => <button type="button" class="pick" data-theme-set={m}>{t(`footer.theme.${m}`)}</button>)}
    </span>
  </div>
</footer>
<style is:global>
  .pick { padding: 0.25rem 0.75rem; border-radius: 99px; border: 1.5px solid var(--line); font-weight: 600; font-size: var(--text-sm); color: var(--muted); }
  .pick:hover { color: var(--text); }
  .pick[aria-pressed='true'], .pick[aria-selected='true'] { background: var(--text); border-color: var(--text); color: var(--bg); }
</style>
