---
import { nav, extras, site, social, sisterUrl } from '@/data/site';
import { useI18n, languageLinks } from '@/i18n';
const { t, href, locale } = useI18n(Astro);
const languages = languageLinks(Astro.url.pathname);
const tools = nav.filter((item) => ['workflow', 'usagebar', 'ghpending', 'tclock', 'frank'].includes(item.id));
const learn = nav.filter((item) => ['book', 'agi', 'limits', 'students', 'writing'].includes(item.id));
const more = nav.filter((item) => ['newsletter', 'podcasts', 'games', 'setup'].includes(item.id));
---
<footer class="border-t border-line">
  <div class="footer-rule" aria-hidden="true"></div>
  <div class="wrap py-14 grid gap-10 md:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1fr_1fr]">
    <div>
      <a href={href("/")} class="wordmark py-2"><span class="dot" aria-hidden="true"></span><span>Akita's AI Lair</span></a>
      <p class="mt-3 text-muted max-w-[26em]">{t('footer.about')}</p>
      <p class="mt-3 text-muted italic">{t('footer.harmless')}</p>
    </div>
    <nav aria-label={t('footer.tools')} class="grid gap-2 content-start">
      <span class="font-sign font-bold">{t('footer.tools')}</span>
      {tools.map((l) => <a href={href(l.href)} class="hover:text-text text-muted py-1.5">{t(`nav.${l.id}.label`)}</a>)}
    </nav>
    <nav aria-label={t('footer.learn')} class="grid gap-2 content-start">
      <span class="font-sign font-bold">{t('footer.learn')}</span>
      {learn.map((l) => <a href={href(l.href)} class="hover:text-text text-muted py-1.5">{t(`nav.${l.id}.label`)}</a>)}
    </nav>
    <nav aria-label={t('footer.more')} class="grid gap-2 content-start">
      <span class="font-sign font-bold">{t('footer.more')}</span>
      {[...more, ...extras].map((l) => <a href={href(l.href)} class="hover:text-text text-muted py-1.5">{t(`nav.${l.id}.label`)}</a>)}
      <a href={sisterUrl('memory', locale)} class="hover:text-text text-muted py-1.5">ai-memory</a>
      <a href={sisterUrl('jail', locale)} class="hover:text-text text-muted py-1.5">ai-jail</a>
      <a href={href('/#contact')} class="hover:text-text text-muted py-1.5">{t('footer.contact')}</a>
    </nav>
    <nav aria-label={t('nav.follow.label')} class="grid gap-2 content-start">
      <span class="font-sign font-bold">{t('nav.follow.label')}</span>
      {social.map((s) => <a href={s.url} class="hover:text-text text-muted py-1.5" rel="me">{t(`social.${s.id}.name`)}</a>)}
    </nav>
  </div>
  <div class="wrap pb-10 flex flex-wrap gap-x-6 gap-y-3 items-center text-sm text-muted">
    <span>© {new Date().getFullYear()} <a class="link" href={site.authorUrl}>{site.author}</a>. {t('footer.rights')}</span>
    <a href="#" data-consent-open class="hover:text-text">{t('footer.cookieSettings')}</a>
    {languages.length > 1 && (
      <span class="flex flex-wrap gap-x-3 gap-y-1">
        {languages.map((l) => <a href={l.url} hreflang={l.htmlLang} lang={l.htmlLang} data-set-lang={l.code} class:list={['hover:text-text', l.code === locale && 'text-text font-semibold']}>{l.label}</a>)}
      </span>
    )}
    <span class="flex gap-1 ms-auto" role="group" aria-label={t('a11y.toggleTheme')}>
      {(['system', 'light', 'dark'] as const).map((m) => <button type="button" class="pick" data-theme-set={m}>{t(`footer.theme.${m}`)}</button>)}
    </span>
  </div>
</footer>
<style is:global>
  /* The footer opens with the fair's double brass rule. */
  .footer-rule { block-size: 6px; border-block: 1.5px solid var(--v-brass); }
  .pick { padding: 0.3rem 0.75rem 0.2rem; border-radius: 0.2rem; border: 1px solid var(--line); font-family: var(--font-sign); font-weight: 600; font-size: var(--text-sm); color: var(--muted); }
  .pick:hover { color: var(--text); }
  .pick[aria-pressed='true'], .pick[aria-selected='true'] { background: var(--text); border-color: var(--text); color: var(--bg); }
</style>
