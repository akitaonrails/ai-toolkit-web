---
import '@/styles/global.css';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Analytics from '@/components/Analytics.astro';
import { site } from '@/data/site';
import ogImage from '@/assets/img/og.png';
import { siteGraph } from '@/lib/schema';
import { useI18n, localizePath, stripLocale } from '@/i18n';
import { defaultLocale, localeCodes, locales } from '@/i18n/config';

interface Props {
  title?: string;
  /** Write a real one, 140 to 160 characters. */
  description?: string;
  /** Extra schema.org objects for this page (FAQPage, ...). */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}
const { t, locale, dir, htmlLang, href } = useI18n(Astro);
const { title, description = t('site.description'), schema = [], noindex = false } = Astro.props;
const tagline = t('site.tagline');
const fullTitle = title ? `${title} | ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const home = new URL(href('/'), Astro.site).href;

// The same page in every language, for <link rel="alternate" hreflang> and the language switcher.
const barePath = stripLocale(Astro.url.pathname);
const alternates = localeCodes.map((l) => ({ hreflang: locales[l].htmlLang, url: new URL(localizePath(l, barePath), Astro.site).href }));
const structuredData = siteGraph({ home, canonical: canonical.href, htmlLang, tagline, description, fullTitle, extra: schema });

// First-visit language detection for hosts without Netlify's edge redirect (and for `npm run preview`).
// Only English pages run it. An `nf_lang` cookie, set by the language switcher, means the visitor already chose.
const detect = locale === defaultLocale && !noindex && localeCodes.length > 1
  ? Object.fromEntries(localeCodes.flatMap((l) => locales[l].match.map((m) => [m, l])))
  : null;
---
<!doctype html>
<html lang={htmlLang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!noindex && alternates.length > 1 && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.url} />)}
    {!noindex && alternates.length > 1 && <link rel="alternate" hreflang="x-default" href={new URL(barePath, Astro.site).href} />}
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large'} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbf8fe" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#14061d" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={locales[locale].og} />
    {localeCodes.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={locales[l].og} />)}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('site.ogAlt')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="author" content={site.author} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {detect && (
      <script is:inline define:vars={{ detect, defaultLocale }}>
        if (!/(?:^|; )nf_lang=/.test(document.cookie)) {
          for (const lang of navigator.languages || [navigator.language]) {
            const hit = detect[String(lang).toLowerCase().split('-')[0]];
            if (!hit) continue;
            if (hit !== defaultLocale) location.replace('/' + hit + location.pathname + location.search + location.hash);
            break;
          }
        }
      </script>
    )}
    <!-- Resolve the theme before first paint: saved choice, else the system setting. -->
    <script is:inline>
      (() => {
        let saved = null;
        try { saved = localStorage.getItem('theme'); } catch {}
        const system = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = saved === 'light' || saved === 'dark' ? saved : system;
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
      })();
    </script>
    <noscript><style>[data-reveal],[data-reveal] > *{opacity:1!important}</style></noscript>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:z-[100] focus:top-3 focus:start-3 btn btn-primary">{t('a11y.skip')}</a>
    <Nav />
    <main id="main"><slot /></main>
    <Footer />
    <Analytics />
    <script>
      import '@/scripts/theme';
      import '@/scripts/motion';
      import '@/scripts/copy';
      import '@/scripts/nav';
    </script>
  </body>
</html>
